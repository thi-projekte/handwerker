<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">

  <servers>
    <server>
      <id>mvn-cibseven-enterprise</id>
      <username>${env.CIBSEVEN_USERNAME}</username>
      <password>${env.CIBSEVEN_PASSWORD}</password>
    </server>
  </servers>

  <profiles>
    <profile>
      <id>cibseven-ee</id>
      <repositories>
        <repository>
          <id>mvn-cibseven-enterprise</id>
          <name>CIB seven Enterprise repository</name>
          <url>https://artifacts.cibseven.org/repository/enterprise-group/</url>
        </repository>
      </repositories>
    </profile>
  </profiles>

  <activeProfiles>
    <activeProfile>cibseven-ee</activeProfile>
  </activeProfiles>

</settings>
