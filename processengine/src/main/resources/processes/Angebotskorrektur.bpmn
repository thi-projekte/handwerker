    <bpmn:serviceTask id="Activity_4.2" name="Angebots-entwurf erstellen">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">https://webhook.site/8ffe7a5c-320f-4839-af43-6c010f6e937f</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="JavaScript">var ergebnisKI = execution.getVariable("ergebnisKI");
var businessKey = execution.getProcessBusinessKey();
var kundendaten = execution.getVariable("customerId");

JSON.stringify({
  businessKey: businessKey,

  customerIdn: customerId,

  angebotspositionen: JSON.parse(
    ergebnisKI.prop("strukturierteAngebotspositionen").toString()
  ),

  korrekturvorschlaege: JSON.parse(
    ergebnisKI.prop("korrekturvorschlaege").toString()
  )
});</camunda:script>
            </camunda:inputParameter>
            <camunda:inputParameter name="contentTyp">application/json</camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_169wxp8</bpmn:incoming>
      <bpmn:outgoing>Flow_0782qmn</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="Activity_4.1" name="Sprach-schnipsel-verarbeitung" calledElement="sprachschnipselverarbeitung">
      <bpmn:extensionElements>
        <camunda:in source="korrekturschnipsel" target="korrekturschnipsel" />
        <camunda:in source="strukturierteAngebotspositionen" target="strukturierteAngebotspositionen" />
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:out source="ergebnisKI" target="ergebnisKI" />
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="JavaScript">var ergebnisKI = execution.getVariable("ergebnisKI");

var strukturierteAngebotspositionen = ergebnisKI.prop("strukturierteAngebotspositionen");

execution.setVariable("strukturierteAngebotspositionen", strukturierteAngebotspositionen);</camunda:script>
        </camunda:executionListener>
