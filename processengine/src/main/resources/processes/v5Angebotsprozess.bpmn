          <camunda:script scriptFormat="JavaScript">var customerId = execution.getVariable("customerId");
var sprachschnipsel = execution.getVariable("sprachschnipsel");
var vorlage = execution.getVariable("vorlage");
var handwerkerId = execution.getVariable("handwerkerId");

