<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0yoyz4c" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_1wnqy36">
    <bpmn:participant id="pool_02" name="Erstangeboterstellung" processRef="erstangebotserstellung" />
    <bpmn:participant id="Participant_1a6hvug" name="Backend" />
    <bpmn:participant id="Participant_12naaur" name="Frontend" />
    <bpmn:messageFlow id="Flow_1lrvkfb" sourceRef="Activity_2.2" targetRef="Participant_1a6hvug" />
  </bpmn:collaboration>
  <bpmn:process id="erstangebotserstellung" isExecutable="true" camunda:historyTimeToLive="10">
    <bpmn:startEvent id="Event_1ek2v5p" name="Erstangebot muss erstellt werden">
      <bpmn:outgoing>Flow_0axxbsn</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="Activity_2.1" name="Sprach-schnipselver-arbeitung" calledElement="sprachschnipselverarbeitung">
      <bpmn:extensionElements>
        <camunda:in source="sprachschnipsel" target="sprachschnipsel" />
        <camunda:in source="vorlage" target="vorlage" />
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in source="handwerkerId" target="handwerkerId" />
        <camunda:out source="ergebnisKI" target="ergebnisKI" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0axxbsn</bpmn:incoming>
      <bpmn:outgoing>Flow_0qed4q0</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="Activity_2.2" name="Erst- angebots-entwurf erstellen">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://offerservice-craftvoice.winfprojekt.de/angebote/${execution.processBusinessKey}/ki-ergebnis</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="JavaScript">var ergebnisKI = execution.getVariable("ergebnisKI");
var customerId = execution.getVariable("customerId");
var businessKey = execution.getProcessBusinessKey();

var payload = JSON.parse(ergebnisKI.toString());

payload.businessKey = businessKey;
payload.customerId = customerId;

JSON.stringify(payload);</camunda:script>
            </camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="X-Handwerker-Id">${handwerkerId}</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:outputParameter name="kiErgebnisStatus">
              <camunda:script scriptFormat="JavaScript">if (statusCode == null || statusCode &gt;= 400) {
  throw new java.lang.RuntimeException(
    "offer-service /ki-ergebnis fehlgeschlagen: HTTP " + statusCode
    + " (businessKey=" + execution.getProcessBusinessKey() + ")");
}
statusCode;</camunda:script>
            </camunda:outputParameter>
            <camunda:outputParameter name="angebotsentwurf">
              <camunda:script scriptFormat="JavaScript">response;</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0qed4q0</bpmn:incoming>
      <bpmn:outgoing>Flow_0pmesfm</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_1tmobws" name="Erstangebot erfolgreich angezeigt">
      <bpmn:incoming>Flow_0pmesfm</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0axxbsn" sourceRef="Event_1ek2v5p" targetRef="Activity_2.1" />
    <bpmn:sequenceFlow id="Flow_0qed4q0" sourceRef="Activity_2.1" targetRef="Activity_2.2" />
    <bpmn:sequenceFlow id="Flow_0pmesfm" sourceRef="Activity_2.2" targetRef="Event_1tmobws" />
  </bpmn:process>
