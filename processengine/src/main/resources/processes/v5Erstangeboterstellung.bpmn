          <dc:Bounds x="884" y="305" width="61" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0axxbsn_di" bpmnElement="Flow_0axxbsn">
        <di:waypoint x="230" y="280" />
        <di:waypoint x="312" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0qed4q0_di" bpmnElement="Flow_0qed4q0">
