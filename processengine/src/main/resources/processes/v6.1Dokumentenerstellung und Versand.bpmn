<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_14uhunb" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_0eis9oj">
    <bpmn:participant id="pool_05" name="Dokumentenerstellung und Versandprozess" processRef="dokumentenerstellungUndVerstand" />
    <bpmn:participant id="Participant_1k8qmmv" name="CraftVoice-Frontend" />
    <bpmn:messageFlow id="Flow_0hajrgt" name="Auftrag zum Nicht-versenden" sourceRef="Participant_1k8qmmv" targetRef="Event_129s0d0" />
    <bpmn:messageFlow id="Flow_0vafef9" name="Auftrag zum versenden" sourceRef="Participant_1k8qmmv" targetRef="Event_0swpcl0" />
  </bpmn:collaboration>
  <bpmn:process id="dokumentenerstellungUndVerstand" isExecutable="true" camunda:historyTimeToLive="10">
    <bpmn:startEvent id="Event_1l0cogb" name="Dokument muss erstellt versendet werden">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#34;rechnung&#34;, execution.hasVariable(&#34;rechnungsentwurf&#34;))}" event="end" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_098kihw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_5.1" name="Dokument-erstellung">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://craftvoice-document.winfprojekt.de/documents/${documentType}/${execution.processBusinessKey}/generate</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="JavaScript">var customerId = execution.getVariable("customerId");
var businessKey = execution.getProcessBusinessKey();
var rechnung = execution.getVariable("rechnung");

var payload = {
  businessKey: businessKey,
  typ: "dokumenterstellung",
  format: "PDF",
  customerId: customerId
};

if (rechnung === true) {

  var rechnungsentwurf = execution.getVariable("rechnungsentwurf");

  payload.dokumentart = "Rechnung";
  payload.rechnungsentwurf = JSON.parse(
    rechnungsentwurf.toString()
  );

} else {

  var angebotsentwurf = execution.getVariable("angebotsentwurf");

  payload.dokumentart = "Angebot";
  payload.angebotsentwurf = JSON.parse(
    angebotsentwurf.toString()
  );
}

JSON.stringify(payload);</camunda:script>
            </camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="JavaScript">if (execution.getVariable("rechnung")) {
    execution.setVariable("documentType", "invoices");
} else {
    execution.setVariable("documentType", "offers");
}</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_098kihw</bpmn:incoming>
      <bpmn:outgoing>Flow_01al5x1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="Gateway_07eg1in" name="Dokument versenden?">
      <bpmn:incoming>Flow_01al5x1</bpmn:incoming>
      <bpmn:outgoing>Flow_0li6atp</bpmn:outgoing>
      <bpmn:outgoing>Flow_0qiimcs</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:endEvent id="Event_1a71put" name="Dokument wurde erfolgreich erstellt und versendet">
      <bpmn:incoming>Flow_1585cu4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="Activity_5.2" name="Dokument-versand" calledElement="dokumentversand">
      <bpmn:extensionElements>
        <camunda:in source="customerId" target="customerId" />
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in source="rechnung" target="rechnung" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1myz5je</bpmn:incoming>
      <bpmn:outgoing>Flow_1585cu4</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="Event_1ofdyba" name="Dokument wurde erfolgreich persistiert">
      <bpmn:incoming>Flow_0bs9ocl</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Event_129s0d0" name="Auftrag zum Nicht-Versenden empfangen">
      <bpmn:incoming>Flow_0qiimcs</bpmn:incoming>
      <bpmn:outgoing>Flow_0bs9ocl</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0joxygl" messageRef="Message_0ul2slp" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_0swpcl0" name="Auftrag zum Versenden empfangen">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_0li6atp</bpmn:incoming>
      <bpmn:outgoing>Flow_1myz5je</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1fjszaj" messageRef="Message_39ap3uo" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_098kihw" sourceRef="Event_1l0cogb" targetRef="Activity_5.1" />
    <bpmn:sequenceFlow id="Flow_01al5x1" sourceRef="Activity_5.1" targetRef="Gateway_07eg1in" />
    <bpmn:sequenceFlow id="Flow_0li6atp" sourceRef="Gateway_07eg1in" targetRef="Event_0swpcl0" />
    <bpmn:sequenceFlow id="Flow_0qiimcs" sourceRef="Gateway_07eg1in" targetRef="Event_129s0d0" />
    <bpmn:sequenceFlow id="Flow_1585cu4" sourceRef="Activity_5.2" targetRef="Event_1a71put" />
    <bpmn:sequenceFlow id="Flow_1myz5je" sourceRef="Event_0swpcl0" targetRef="Activity_5.2" />
    <bpmn:sequenceFlow id="Flow_0bs9ocl" sourceRef="Event_129s0d0" targetRef="Event_1ofdyba" />
  </bpmn:process>
