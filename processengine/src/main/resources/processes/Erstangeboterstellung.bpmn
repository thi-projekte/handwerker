      <bpmn:outgoing>Flow_0axxbsn</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="Activity_2.1" name="Sprach-schnipselver-arbeitung" calledElement="sprachschnipselverarbeitung">
      <bpmn:extensionElements>
        <camunda:in source="sprachschnipsel" target="sprachschnipsel" />
        <camunda:in source="vorlage" target="vorlage" />
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:out source="ergebnisKI" target="ergebnisKI" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0axxbsn</bpmn:incoming>
      <bpmn:outgoing>Flow_0qed4q0</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="Activity_2.2" name="Erst- angebots-entwurf erstellen">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">https://webhook.site/8ffe7a5c-320f-4839-af43-6c010f6e937f</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="JavaScript">var ergebnisKI = execution.getVariable("ergebnisKI");
var kundendaten = execution.getVariable("customerId");
var businessKey = execution.getProcessBusinessKey();

JSON.stringify({
  businessKey: businessKey,

  customerId: customerId, 

  strukturierteAngebotspositione: JSON.parse(
    ergebnisKI.prop("strukturierteAngebotspositionen").toString()
  ),

  korrekturvorschlaege: JSON.parse(
    ergebnisKI.prop("korrekturvorschlaege").toString()
  )
});</camunda:script>
            </camunda:inputParameter>
            <camunda:inputParameter name="contentType">application/json</camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0qed4q0</bpmn:incoming>
      <bpmn:outgoing>Flow_0pmesfm</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_1tmobws" name="Erstangebot erfolgreich angezeigt">
      <bpmn:incoming>Flow_0vhx2td</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Event_10bgkb0" name="Erstangebots-entwurf emfangen">
      <bpmn:incoming>Flow_0pmesfm</bpmn:incoming>
      <bpmn:outgoing>Flow_0n1nv9b</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0bvvao6" messageRef="Message_3n3lqjh" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Activity_2.3" name="Erst-    angebots-entwurf anzeigen">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">https://webhook.site/8ffe7a5c-320f-4839-af43-6c010f6e937f</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="JavaScript">var angebotsentwurf = execution.getVariable("angebotsentwurf");
var customerId = execution.getVariable("customerId");
var businessKey = execution.getProcessBusinessKey();

JSON.stringify({
  businessKey: businessKey,
  customerId: customerId,

  angebotsentwurf: JSON.parse(
    angebotsentwurf.toString()
  )
});</camunda:script>
            </camunda:inputParameter>
            <camunda:inputParameter name="contentType">application/json</camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0n1nv9b</bpmn:incoming>
      <bpmn:outgoing>Flow_0vhx2td</bpmn:outgoing>
    </bpmn:serviceTask>
