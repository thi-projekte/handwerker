    <bpmn:serviceTask id="Activity_7.1" name="Rechnungsentwurf erstellen">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://offerservice-craftvoice.winfprojekt.de/rechnungen</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="JavaScript">var businessKey = execution.getProcessBusinessKey();

JSON.stringify({
  businessKey: businessKey
});</camunda:script>
            </camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1143mg2</bpmn:incoming>
      <bpmn:outgoing>Flow_151fr3f</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_18kkes0" name="Rechnungsentwurf empfangen">
      <bpmn:incoming>Flow_151fr3f</bpmn:incoming>
      <bpmn:outgoing>Flow_1agn65y</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0zbkuvw" messageRef="Message_1np93cl" />
    </bpmn:intermediateCatchEvent>
    <bpmn:callActivity id="Activity_7.2" name="Dokumenten-erstellung und Versandprozess" calledElement="dokumentenerstellungUndVerstand">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in source="rechnungsentwurf" target="rechnungsentwurf" />
        <camunda:in source="customerId" target="customerId" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1agn65y</bpmn:incoming>
      <bpmn:outgoing>Flow_0vk6y79</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="Event_15rs1hz" name="Rechnung wurde erfolgreich  erstellt und versendet">
      <bpmn:incoming>Flow_0vk6y79</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_0pehyu9" name="Rechnung wurde nicht erstellt und versendet">
      <bpmn:incoming>Flow_0oqc661</bpmn:incoming>
    </bpmn:endEvent>
