<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_052ckjh" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_13w5r0a">
    <bpmn:participant id="pool_06" name="Dokumentversandprozess" processRef="dokumentversand" />
    <bpmn:participant id="Participant_1g6mume" name="Backend" />
    <bpmn:messageFlow id="Flow_0kxurh5" name="Dokument" sourceRef="Activity_6.1" targetRef="Participant_1g6mume" />
    <bpmn:messageFlow id="Flow_1761w2n" sourceRef="Activity_6.2" targetRef="Participant_1g6mume" />
  </bpmn:collaboration>
  <bpmn:process id="dokumentversand" isExecutable="true" camunda:historyTimeToLive="10">
    <bpmn:startEvent id="Event_1g2j0m2" name="Dokument muss verschickt werden">
      <bpmn:outgoing>Flow_14uke9r</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="Event_0wiueb8" name="Dokument erfolgreich versendet">
      <bpmn:incoming>Flow_0nzzrbu</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_14uke9r" sourceRef="Event_1g2j0m2" targetRef="Activity_6.1" />
    <bpmn:sequenceFlow id="Flow_0rjimwc" sourceRef="Activity_6.1" targetRef="Activity_6.2" />
    <bpmn:sendTask id="Activity_6.1" name="Dokument versenden">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://craftvoice-document.winfprojekt.de/documents/${documentType}/${execution.processBusinessKey}/share</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="JavaScript">var customerId = execution.getVariable("customerId");
var businessKey = execution.getProcessBusinessKey();
var rechnung = execution.getVariable("rechnung");

var payload = {
  businessKey: businessKey,
  customerId: customerId
};

if (rechnung === true) {
  payload.dokumentart = "Rechnung";
} else {
  payload.dokumentart = "Angebot";
}

JSON.stringify(payload);</camunda:script>
            </camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="JavaScript">if (execution.getVariable("rechnung")) {
    execution.setVariable("documentType", "invoices");
} else {
    execution.setVariable("documentType", "offers");
}</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_14uke9r</bpmn:incoming>
      <bpmn:outgoing>Flow_0rjimwc</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_0nzzrbu" sourceRef="Activity_6.2" targetRef="Event_0wiueb8" />
    <bpmn:serviceTask id="Activity_6.2" name="Verstand-bestätigung senden">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
        <camunda:inputOutput>
          <camunda:inputParameter name="url">http://offerservice-craftvoice.winfprojekt.de/angebote/${execution.processBusinessKey}/versendet</camunda:inputParameter>
          <camunda:inputParameter name="method">POST</camunda:inputParameter>
          <camunda:inputParameter name="payload">
            <camunda:script scriptFormat="JavaScript">var customerId = execution.getVariable("customerId");
var businessKey = execution.getProcessBusinessKey();

JSON.stringify({
  businessKey: businessKey,
  customerId: customerId
});</camunda:script>
          </camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0rjimwc</bpmn:incoming>
      <bpmn:outgoing>Flow_0nzzrbu</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
