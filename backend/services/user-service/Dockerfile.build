# Stage 1: Build with Maven
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /usr/src/app

# Wir erstellen eine minimale settings.xml
RUN echo '<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"><profiles></profiles></settings>' > /usr/src/app/clean-settings.xml

# SSL-Prüfung deaktivieren (notwendig für Netzwerke mit SSL-Interception/Proxy)
ENV MAVEN_OPTS="-Dmaven.wagon.http.ssl.insecure=true -Dmaven.wagon.http.ssl.allowall=true -Dmaven.wagon.http.ssl.ignore.validity.dates=true"

# Kopiere die Dateien
COPY pom.xml .
COPY src ./src

# Baue das Projekt und ignoriere SSL-Fehler beim Download der Abhängigkeiten
RUN mvn package -DskipTests -B -s /usr/src/app/clean-settings.xml ${MAVEN_OPTS}

# Stage 2: Runtime
FROM registry.access.redhat.com/ubi9/openjdk-17-runtime:latest
ENV LANGUAGE='en_US:en'

COPY --from=build /usr/src/app/target/quarkus-app/lib/ /deployments/lib/
COPY --from=build /usr/src/app/target/quarkus-app/*.jar /deployments/
COPY --from=build /usr/src/app/target/quarkus-app/app/ /deployments/app/
COPY --from=build /usr/src/app/target/quarkus-app/quarkus/ /deployments/quarkus/

EXPOSE 8082
USER 185
ENV JAVA_APP_JAR="/deployments/quarkus-run.jar"
ENTRYPOINT [ "/opt/jboss/container/java/run/run-java.sh" ]
