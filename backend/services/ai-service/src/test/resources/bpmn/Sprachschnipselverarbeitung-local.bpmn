<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0ejgl0b" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_042vbpn">
    <bpmn:participant id="pool_03" name="Sprachschnipselverarbeitung" processRef="sprachschnipselverarbeitung" />
    <bpmn:participant id="Participant_09kwgqt" name="KI-Backend" />
    <bpmn:messageFlow id="Flow_19wur4r" name="Sprachschnipsel&#10;und Vorlage" sourceRef="Activity_3.1" targetRef="Participant_09kwgqt" />
    <bpmn:messageFlow id="Flow_0n6lggq" name="strukturierte Angebots-positionen und Korrektur-vorschläge" sourceRef="Participant_09kwgqt" targetRef="Activity_3.2" />
  </bpmn:collaboration>
  <bpmn:process id="sprachschnipselverarbeitung-local" name="Sprachschnipselverarbeitung (LOKAL - Test gegen ai-service)" isExecutable="true" camunda:historyTimeToLive="10">
    <bpmn:startEvent id="Event_1c6l65c" name="Sprachschnipsel müssen verarbeitet werden">
      <bpmn:outgoing>Flow_1lb7m41</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="Event_1xgl5t6" name="Verarbeitung erfolgreich">
      <bpmn:incoming>Flow_1hhu01x</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Activity_3.1" name="Sprach-schnipsel und Vorlage versenden">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://host.docker.internal:8081/ai/process</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="JavaScript">var korrekturschnipsel = execution.getVariable("korrekturschnipsel");
var angebotsentwurf = execution.getVariable("angebotsentwurf");
var vorlage = execution.getVariable("vorlage");
var sprachschnipsel = execution.getVariable("sprachschnipsel");

var businessKey = execution.getProcessBusinessKey();

var payload = {};

payload.businessKey = businessKey;

if (korrekturschnipsel !== null &amp;&amp; angebotsentwurf !== null) {

  payload.prompt = "Überarbeite den Angebotsentwurf anhand des Korrekturschnipsels.";

  payload.angebotsentwurf = JSON.parse(
    angebotsentwurf.toString()
  );

  payload.korrekturschnipsel = korrekturschnipsel.toString();

} else {

  payload.prompt = "Erstelle ein Erstangebot anhand von Vorlage und Sprachschnipsel.";

  payload.vorlage = vorlage !== null
    ? JSON.parse(vorlage.toString())
    : {
        leistungen: [],
        material: [],
        notizen: []
      };

  payload.sprachschnipsel = sprachschnipsel === null
    ? ""
    : sprachschnipsel.toString();
}

JSON.stringify(payload);</camunda:script>
            </camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1lb7m41</bpmn:incoming>
      <bpmn:outgoing>Flow_0gfrtp2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Activity_3.2" name="strukturierte Angebots-positionen und Korrektur-vorschläge  empfangen" messageRef="Message_3c00n9k">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="JavaScript">var ergebnisKIString = execution.getVariable("ergebnisKI").toString();
var ergebnisKIJson = S(ergebnisKIString);

execution.setVariable("ergebnisKI", ergebnisKIJson);</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0gfrtp2</bpmn:incoming>
      <bpmn:outgoing>Flow_1hhu01x</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sequenceFlow id="Flow_1lb7m41" sourceRef="Event_1c6l65c" targetRef="Activity_3.1" />
    <bpmn:sequenceFlow id="Flow_1hhu01x" sourceRef="Activity_3.2" targetRef="Event_1xgl5t6" />
    <bpmn:sequenceFlow id="Flow_0gfrtp2" sourceRef="Activity_3.1" targetRef="Activity_3.2" />
  </bpmn:process>
  <bpmn:message id="Message_3c00n9k" name="ergebnisKI" />
