  <bpmn:collaboration id="Collaboration_1wnqy36">
    <bpmn:participant id="pool_02" name="Erstangeboterstellung" processRef="erstangebotserstellung" />
  </bpmn:collaboration>
  <bpmn:process id="erstangebotserstellung" isExecutable="true" camunda:historyTimeToLive="10">
    <bpmn:startEvent id="Event_1ek2v5p" name="Erstangebot muss erstellt werden">
      <bpmn:outgoing>Flow_0axxbsn</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="Activity_2.1" name="Sprach-schnipselver-arbeitung" calledElement="sprachschnipselverarbeitung">
      <bpmn:extensionElements>
        <camunda:in source="sprachschnipsel" target="sprachschnipsel" />
        <camunda:in source="vorlage" target="vorlage" />
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:out source="ergebnisKI" target="ergebnisKI" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0axxbsn</bpmn:incoming>
      <bpmn:outgoing>Flow_0qed4q0</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="Event_1tmobws" name="Erstangebot erfolgreich angezeigt">
      <bpmn:incoming>Flow_0pmesfm</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0axxbsn" sourceRef="Event_1ek2v5p" targetRef="Activity_2.1" />
    <bpmn:sequenceFlow id="Flow_0qed4q0" sourceRef="Activity_2.1" targetRef="Activity_2.2" />
    <bpmn:sequenceFlow id="Flow_0pmesfm" sourceRef="Activity_2.2" targetRef="Event_1tmobws" />
    <bpmn:serviceTask id="Activity_2.2" name="Erstangebot erstellen und anzeigen">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">https://webhook.site/c1d3dcf2-e52d-48c8-ae9e-313883a72129</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="JavaScript">var ergebnisKI = execution.getVariable("ergebnisKI");
var kundendaten = execution.getVariable("kundendaten");
var businessKey = execution.getProcessBusinessKey();

JSON.stringify({
  businessKey: businessKey,

  kundendaten: JSON.parse(
    kundendaten.toString()
  ),

  angebotspositionen: JSON.parse(
    ergebnisKI.prop("strukturierteAngebotspositionen").toString()
  ),

  korrekturvorschlaege: JSON.parse(
    ergebnisKI.prop("korrekturvorschlaege").toString()
  )
});</camunda:script>
            </camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0qed4q0</bpmn:incoming>
      <bpmn:outgoing>Flow_0pmesfm</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
