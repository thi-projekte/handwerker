    <bpmn:startEvent id="Event_0ag11bx">
      <bpmn:outgoing>Flow_17niv5q</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:eventBasedGateway id="Gateway_02rd13u" name="Angebot korrigieren?">
      <bpmn:incoming>Flow_17niv5q</bpmn:incoming>
      <bpmn:outgoing>Flow_0ce6u3e</bpmn:outgoing>
      <bpmn:outgoing>Flow_0hyqud8</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_152vaxu" name="strukturierte Angebots-positionen und Korrektur-schnipsel&#10;empfangen">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="JavaScript">var angebotsentwurf = execution.getVariable("angebotsentwurf");
var korrekturschnipsel = execution.getVariable("korrekturschnipsel");

execution.setVariable("angebotsentwurf", angebotsentwurf);
execution.setVariable("korrekturschnipsel", korrekturschnipsel);

execution.setVariable("angebotsgenehmigung", false);</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ce6u3e</bpmn:incoming>
      <bpmn:outgoing>Flow_0qs32fn</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_05nwct8" messageRef="Message_1a8dtpo" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_0rauegq" name="Genehmigung empfangen">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="angebotsgenehmigung">${true}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0hyqud8</bpmn:incoming>
      <bpmn:outgoing>Flow_0thqi5y</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0wlaaoa" messageRef="Message_340suoo" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Activity_1ia660s" name="Angebot erstellen">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">https://webhook.site/c1d3dcf2-e52d-48c8-ae9e-313883a72129</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="JavaScript">var ergebnisKI = execution.getVariable("ergebnisKI");
var businessKey = execution.getProcessBusinessKey();
var kundendaten = execution.getVariable("kundendaten");

JSON.stringify({
  businessKey: businessKey,

  kundendaten: JSON.parse(
    kundendaten.toString()
  ),

  angebotspositionen: JSON.parse(
    ergebnisKI.prop("strukturierteAngebotspositionen").toString()
  ),

  korrekturvorschlaege: JSON.parse(
    ergebnisKI.prop("korrekturvorschlaege").toString()
  )
});</camunda:script>
            </camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_169wxp8</bpmn:incoming>
      <bpmn:outgoing>Flow_0782qmn</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_157wgkm" name="Angebots-genehmigung nicht erfolgreich">
      <bpmn:incoming>Flow_0782qmn</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_1oh23wl" name="Angebots-genehmigung erfolgreich">
      <bpmn:incoming>Flow_0thqi5y</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="Activity_11yb8rn" name="Sprach-schnipsel-verarbeitung" calledElement="sprachschnipselverarbeitung">
      <bpmn:extensionElements>
        <camunda:in source="korrekturschnipsel" target="korrekturschnipsel" />
        <camunda:in source="angebotsentwurf" target="angebotsentwurf" />
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:out source="ergebnisKI" target="ergebnisKI" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0qs32fn</bpmn:incoming>
      <bpmn:outgoing>Flow_169wxp8</bpmn:outgoing>
    </bpmn:callActivity>
