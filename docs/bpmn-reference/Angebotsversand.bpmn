  <bpmn:process id="angebotsversand" isExecutable="true" camunda:historyTimeToLive="10">
    <bpmn:startEvent id="Event_1g2j0m2" name="Angebot muss verschickt werden">
      <bpmn:outgoing>Flow_14uke9r</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Activity_09xtlrv" name="Angebot versenden">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">https://webhook.site/c1d3dcf2-e52d-48c8-ae9e-313883a72129</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="JavaScript">var kundendaten = execution.getVariable("kundendaten");

var businessKey = execution.getProcessBusinessKey();
var processInstanceId = execution.getProcessInstanceId();

var payload = {
  businessKey: businessKey,
  processInstanceId: processInstanceId,

  kundendaten: JSON.parse(kundendaten.toString()),

  pdf: {
    variableName: "pdf",
    downloadUrl: "/engine-rest/process-instance/" 
      + processInstanceId 
      + "/variables/pdf/data"
  }
};

JSON.stringify(payload);</camunda:script>
            </camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_14uke9r</bpmn:incoming>
      <bpmn:outgoing>Flow_0rjimwc</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_0wiueb8" name="Angebot erfolgreich versendet">
      <bpmn:incoming>Flow_0rjimwc</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_14uke9r" sourceRef="Event_1g2j0m2" targetRef="Activity_09xtlrv" />
    <bpmn:sequenceFlow id="Flow_0rjimwc" sourceRef="Activity_09xtlrv" targetRef="Event_0wiueb8" />
  </bpmn:process>
